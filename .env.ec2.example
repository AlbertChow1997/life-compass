# Copy this file to .env on the EC2 host and fill in real secrets.
# Do not commit the real .env file.

# MySQL container and Spring datasource
DB_NAME=lifecompass
DB_USERNAME=lifecompass
DB_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password
DB_USE_SSL=false

# Redis container
REDIS_PORT=6379

# Backend runtime
LIFECOMPASS_JWT_SECRET=replace-with-at-least-32-bytes-random-secret
LIFECOMPASS_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.com

# Optional login/integration providers
GOOGLE_CLIENT_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
DEEPSEEK_API_KEY=
