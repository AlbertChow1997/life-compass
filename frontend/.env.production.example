# Production frontend build settings.
#
# VITE_API_BASE_URL should point at the deployed Spring Boot API root.
# VITE_ASSET_BASE_URL should point at the origin serving /images and /uploads.
# If backend still serves images/uploads, use the backend origin without /api.

VITE_API_BASE_URL=https://api.example.com/api
VITE_ASSET_BASE_URL=https://api.example.com
